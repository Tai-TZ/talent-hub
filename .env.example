# Copy file này thành .env và điền giá trị. KHÔNG commit .env.

# ---- Backend ----
ENVIRONMENT=local
# Vai trò runtime: không superuser, không BYPASSRLS
DATABASE_URL=postgresql+asyncpg://talenthub_app:app@localhost:5432/talenthub
# Vai trò chủ sở hữu bảng: chỉ cho migration và CLI
MIGRATION_DATABASE_URL=postgresql+asyncpg://talenthub_owner:owner@localhost:5432/talenthub
JWT_SECRET=dev-only-change-me-dev-only-change-me
ALLOW_ORG_HEADER=true
ALLOWED_ORIGINS=["http://localhost:3000"]

# ---- AI (tuỳ chọn; không có khoá nào thì chạy động cơ offline) ----
# Bật LLM: AI_ENGINE=llm (hoặc đổi trong Quản trị → Cài đặt của từng tổ chức).
# AI_ENGINE=llm
# LLM_PROVIDER: auto (mặc định: có LLM_API_KEY thì dùng dịch vụ tương thích OpenAI, không thì ANTHROPIC_API_KEY),
# openai_compatible hoặc anthropic.
# LLM_PROVIDER=auto
#
# OpenRouter (mặc định khi đặt LLM_API_KEY):
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_SCORING_MODEL=google/gemini-2.5-flash
# LLM_ASSISTANT_MODEL=google/gemini-2.5-flash-lite
#
# OpenAI:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_SCORING_MODEL=gpt-4.1-mini
# LLM_ASSISTANT_MODEL=gpt-4.1-mini
#
# Gemini (Google AI Studio, lớp tương thích OpenAI):
# LLM_API_KEY=AIza...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_SCORING_MODEL=gemini-2.5-flash
# LLM_ASSISTANT_MODEL=gemini-2.5-flash-lite
#
# Mô hình không hỗ trợ JSON Schema (structured output): đặt json_object, đầu ra vẫn được kiểm chứng.
# LLM_JSON_MODE=json_schema
# Mô hình chưa có trong bảng giá (backend/src/ai/pricing.py): USD mỗi triệu token, cần đặt cả hai.
# LLM_PRICE_INPUT_PER_MTOK=0.30
# LLM_PRICE_OUTPUT_PER_MTOK=2.50
#
# Anthropic (Claude):
# ANTHROPIC_API_KEY=sk-ant-...
# AI_SCORING_MODEL=claude-opus-5-5
# ASSISTANT_MODEL=claude-haiku-4-5-20251001

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Tổ chức mặc định khi chạy local (gửi qua header X-Organization)
NEXT_PUBLIC_DEFAULT_ORG=northwind
